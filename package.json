{
  "name": "@roqueos-games/jogo-sdk",
  "version": "0.7.3",
  "description": "O contrato entre o RoqueOS e um jogo: mount(el, host), as capacidades do host, um host para rodar o jogo sozinho, um host falso para teste e o jogo check.",
  "license": "MIT",
  "author": "Roque Ribeiro",
  "repository": {
    "type": "git",
    "url": "https://github.com/roqueos-games/jogo-sdk.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./host-de-desenvolvimento": "./src/host/desenvolvimento.js",
    "./host-falso": "./src/host/falso.js",
    "./armazenamento": "./src/host/armazenamento.js",
    "./sala-ao-vivo": "./src/host/salaAoVivo.js",
    "./presenca": "./src/host/presenca.js",
    "./modelos": "./src/modelos.js",
    "./grafico": "./src/grafico.js",
    "./painel": "./src/painel.js",
    "./pacote": "./src/pacote.js",
    "./som": "./src/som.js",
    "./carga": "./src/carga.js"
  },
  "bin": {
    "jogo": "./bin/jogo.mjs"
  },
  "files": [
    "src",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "yarn lint && yarn format:check && yarn test && yarn jogo:check",
    "jogo:check": "node bin/jogo.mjs check --sdk",
    "mutantes": "node test/mutantes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "eslint": "9.14.0",
    "globals": "16.4.0",
    "meshoptimizer": "1.1.1",
    "prettier": "3.3.3",
    "sharp": "0.35.4",
    "three": "0.171.0"
  }
}
